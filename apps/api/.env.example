DATABASE_URL="postgresql://brewlite:brewlite@localhost:5433/brewlite?schema=public"
JWT_SECRET="doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien"
JWT_EXPIRES_IN="7d"
PORT=4000
# Có thể khai báo nhiều origin, ngăn cách bằng dấu phẩy
FRONTEND_URL="http://localhost:3000"
# Đơn PENDING / PAYMENT_FAILED quá số phút này sẽ tự hủy và hoàn kho, mã, điểm (FR-27)
ORDER_EXPIRE_MINUTES=15
# Khách chỉ tự hủy + được hoàn tiền đơn đã thanh toán trong số phút này kể từ lúc thanh toán
REFUND_WINDOW_MINUTES=5
# RabbitMQ: gửi/nhận sự kiện đơn hàng (order.created / paid / cancelled / refunded).
# Để trống hoặc xóa dòng này thì tắt RabbitMQ, API vẫn chạy bình thường.
# Chạy API thủ công trên máy: để trống. Chạy bằng docker compose: compose tự đặt biến này
# (amqp://...@rabbitmq:5672), không cần khai báo ở đây.
RABBITMQ_URL=""
