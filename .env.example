# Biến môi trường cho docker-compose.yml
# Sao chép thành .env để ghi đè; không có .env thì docker-compose dùng giá trị mặc định này.
# (Chạy thủ công không qua Docker thì dùng apps/api/.env.example và apps/web/.env.example)

# --- PostgreSQL ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite

# --- Backend (apps/api) ---
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# --- Frontend (apps/web) ---
# Trình duyệt gọi trực tiếp backend nên dùng địa chỉ localhost
NEXT_PUBLIC_API_URL=http://localhost:4000
