@startuml class-domain-model
' ============================================================
' BrewLite – Sơ đồ lớp miền nghiệp vụ (domain model)
' Thuộc tính khớp apps/api/prisma/schema.prisma; phương thức khớp các service
' (OrdersService, PaymentsService, LoyaltyService, PromotionsService, ProductsService,
'  AuthService) và hàm trong common/pricing.ts, orders/order-state-machine.ts.
' ============================================================
title BrewLite – Class diagram (domain model)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor Black
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor White
  BorderColor Black
  HeaderBackgroundColor #EEF2F6
}
hide circle
hide empty members

class User {
  +Int id
  +String name
  +String email «unique»
  +String phone «optional»
  +String passwordHash
  +Int loyaltyPoints
  +DateTime createdAt
  --
  +Boolean verifyPassword(String plain)
  +Boolean hasEnoughPoints(Int points)
  +void addPoints(Int points)
  +void deductPoints(Int points)
  +PublicUser toPublic()
}

class LoyaltyTransaction {
  +Int id
  +LoyaltyType type
  +Int points
  +DateTime createdAt
  --
  +Int signedPoints()
  +{static} LoyaltyTransaction earn(Int userId, Int orderId, Int points)
  +{static} LoyaltyTransaction redeem(Int userId, Int orderId, Int points)
  +{static} LoyaltyTransaction refund(Int userId, Int orderId, Int points)
  +{static} LoyaltyTransaction revoke(Int userId, Int orderId, Int points)
}

class Promotion {
  +Int id
  +String code «unique»
  +String title
  +DiscountType type
  +Int value
  +Int minOrder
  +Int maxDiscount «optional»
  +DateTime startsAt
  +DateTime endsAt
  +Int usageLimit «optional»
  +Int usedCount
  +Boolean isActive
  --
  +Boolean isApplicable(Int subtotal, DateTime now)
  +Int calcDiscount(Int subtotal)
  +void consume()
  +void release()
}

class Order {
  +Int id
  +OrderStatus status
  +Int subtotal
  +Int discount
  +Int pointsUsed
  +Int total
  +String couponCode «optional»
  +String note «optional, ≤ 200»
  +Int pointsEarned
  +Boolean pointsAwarded
  +DateTime createdAt
  +DateTime updatedAt
  +Int version
  --
  +void addItem(OrderItem item)
  +void calcTotals()
  +Int earnedPoints()
  +Boolean canTransitionTo(OrderStatus next)
  +void transitionTo(OrderStatus next)
  +void markPaid()
  +void markPaymentFailed()
  +void cancel()
  +Boolean isExpired(Int minutes, DateTime now)
  +Boolean isRefundable(Int windowMinutes, DateTime now)
  +void refund()
}

class OrderStatusLog {
  +Int id
  +OrderStatus status
  +DateTime createdAt
  --
  +{static} OrderStatusLog record(Int orderId, OrderStatus status)
}

class Payment {
  +Int id
  +String idempotencyKey «unique»
  +Int amount
  +PaymentMethod method
  +String provider
  +PaymentStatus status
  +String transactionId «optional»
  +String failureReason «optional»
  +String refundTransactionId «optional»
  +DateTime refundedAt «optional»
  +DateTime createdAt
  --
  +Boolean isSuccessful()
  +void markSuccess(String transactionId)
  +void markFailed(String reason)
  +void startRefund()
  +void markRefunded(String refundTransactionId)
}

class OrderItem {
  +Int id
  +String productName
  +Size size
  +Int sugar «0|30|50|70|100»
  +IceLevel ice
  +Json toppings «snapshot»
  +Int unitPrice
  +Int qty «1..20»
  +Int lineTotal
  --
  +Int calcUnitPrice()
  +Int calcLineTotal()
}

class Product {
  +Int id
  +String name
  +String description
  +String category
  +Int basePrice
  +String imageUrl
  +Int stock
  +Boolean isActive
  +Boolean isFeatured
  +Int version
  --
  +Boolean isAvailable(Int qty)
  +void reserveStock(Int qty)
  +void releaseStock(Int qty)
  +Int priceForSize(Size size)
}

class Topping {
  +Int id
  +String name
  +Int price
  +Boolean isActive
  --
  +Boolean isSelectable()
}

class LoyaltyType <<enumeration>> {
  EARN
  REDEEM
  REFUND
  REVOKE
}

class DiscountType <<enumeration>> {
  PERCENT
  FIXED
}

class PaymentMethod <<enumeration>> {
  WALLET
  CARD
}

class PaymentStatus <<enumeration>> {
  PROCESSING
  SUCCESS
  FAILED
  REFUNDING
  REFUNDED
}

class IceLevel <<enumeration>> {
  NO_ICE
  LESS_ICE
  REGULAR
}

class Size <<enumeration>> {
  S
  M
  L
}

class OrderStatus <<enumeration>> {
  PENDING
  PAID
  PAYMENT_FAILED
  CANCELLED
  REFUNDED
}

User "1" --> "0..*" LoyaltyTransaction : có sổ điểm
User "1" --> "0..*" Order : đặt
Order "1" --> "0..*" LoyaltyTransaction : phát sinh điểm
Order "0..*" --> "0..1" Promotion : áp dụng mã
Order "1" *-- "1..*" OrderStatusLog : nhật ký trạng thái
Order "1" --> "0..*" Payment : thanh toán bằng
Order "1" *-- "1..*" OrderItem : gồm
OrderItem "0..*" --> "1" Product : tham chiếu
OrderItem "0..*" ..> "0..*" Topping : chọn kèm
Order ..> OrderStatus
OrderStatusLog ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Promotion ..> DiscountType
LoyaltyTransaction ..> LoyaltyType
OrderItem ..> Size
OrderItem ..> IceLevel

@enduml
